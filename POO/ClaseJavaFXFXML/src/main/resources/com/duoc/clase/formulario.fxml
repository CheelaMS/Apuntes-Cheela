<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.duoc.clase.FormularioController"
        alignment="CENTER"
        spacing="15">

    <Label text="Registro de Usuario"/>

    <TextField
            fx:id="txtNombre"
            promptText="Ingrese su nombre"
            maxWidth="250"/>

    <ComboBox
            fx:id="cmbTipo"
            promptText="Selecciona un tipo de usuario"
            maxWidth="250"/>

    <Button
            text="Registrar"
            onAction="#registrar"/>

    <Label fx:id="lblResultado"/>

</VBox>